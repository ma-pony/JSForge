{
  "name": "deepspider",
  "version": "1.0.0",
  "description": "AI-native web scraping and JavaScript reverse-engineering platform powered by DSH, Patchright/CDP, semantic recovery, and verifiable Solvers",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "main": "src/mcp/server.js",
  "files": [
    "bin/",
    "src/",
    "dsh/",
    "skills/",
    "README.md",
    "README_EN.md",
    "requirements-crypto.txt",
    ".env.example"
  ],
  "bin": {
    "deepspider": "bin/cli.js",
    "deepspider-mcp": "src/mcp/server.js"
  },
  "scripts": {
    "mcp": "node src/mcp/server.js",
    "cli": "node bin/cli.js",
    "test": "node scripts/run-unit-tests.mjs",
    "test:integration": "node --test 'test/integration/*.test.js'",
    "smoke:pack": "node scripts/smoke-packed-cli.mjs",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "setup:crypto": "uv venv .venv --python 3.11 2>/dev/null || true && uv pip install -r requirements-crypto.txt",
    "postinstall": "patchright install chromium",
    "prepare": "husky"
  },
  "keywords": [
    "crawler",
    "web-scraping",
    "javascript",
    "reverse-engineering",
    "deobfuscation",
    "captcha",
    "anti-detect",
    "automation"
  ],
  "author": "pony-ma",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ma-pony/deepspider.git"
  },
  "homepage": "https://github.com/ma-pony/deepspider#readme",
  "bugs": {
    "url": "https://github.com/ma-pony/deepspider/issues"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "latest",
    "@deepseek-ai/dsh-host-apiproxy": "next",
    "@deepseek-ai/dsh-llm": "next",
    "@deepseek-ai/dsh-tools": "next",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "acorn": "^8.18.0",
    "cycletls": "^2.0.5",
    "patchright": "^1.57.0",
    "sdenv": "latest",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7"
  },
  "lint-staged": {
    "*.js": "eslint --fix"
  }
}
